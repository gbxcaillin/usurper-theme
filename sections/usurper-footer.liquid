{%- comment -%} Usurper footer: brand, two menus, base line with payment icons {%- endcomment -%}
<footer class="u-footer">
  <div class="page-width">
    <div class="u-footer__grid">
      <div class="u-footer__brand">
        {%- if section.settings.logo != blank -%}
          {{ section.settings.logo | image_url: width: 400 | image_tag: alt: shop.name, loading: 'lazy', widths: '200, 400' }}
        {%- else -%}
          <div class="u-wordmark u-wordmark--left">
            <img src="{{ 'usurper-crown.webp' | asset_url }}" alt="{{ shop.name }} crown mark" width="200" height="192" loading="lazy">
            <span>{{ shop.name }}</span>
          </div>
        {%- endif -%}
        {%- if section.settings.text != blank -%}<p>{{ section.settings.text }}</p>{%- endif -%}
      </div>

      {%- for block in section.blocks -%}
        {%- if block.type == 'menu' and block.settings.menu != blank -%}
          <div {{ block.shopify_attributes }}>
            <h4>{{ block.settings.heading | default: block.settings.menu.title }}</h4>
            <ul>
              {%- for link in block.settings.menu.links -%}
                <li><a href="{{ link.url }}">{{ link.title }}</a></li>
              {%- endfor -%}
            </ul>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>

    <div class="u-footer__base">
      <span>{{ section.settings.copyright }}</span>
      {%- if section.settings.show_policies and shop.policies.size > 0 -%}
        <div class="u-footer__policies">
          {%- for policy in shop.policies -%}
            <a href="{{ policy.url }}">{{ policy.title }}</a>
          {%- endfor -%}
        </div>
      {%- endif -%}
      {%- if section.settings.show_payment -%}
        <div class="u-footer__payment" aria-label="{{ 'sections.footer.payment' | t }}">
          {%- for type in shop.enabled_payment_types -%}
            {{ type | payment_type_svg_tag: class: 'icon icon--full-color' }}
          {%- endfor -%}
        </div>
      {%- endif -%}
      <span><b>{{ section.settings.tagline }}</b></span>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Usurper footer",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "image_picker", "id": "logo", "label": "Combo logo", "info": "Falls back to the crown mark and a text wordmark." },
    { "type": "textarea", "id": "text", "label": "Positioning line", "default": "Heavyweight streetwear built to last. True to size for every frame, made to order, and honest about it." },
    { "type": "text", "id": "copyright", "label": "Copyright line", "default": "© Usurper · Melbourne, Australia" },
    { "type": "text", "id": "tagline", "label": "Tagline", "default": "Buy less. Buy better." },
    { "type": "checkbox", "id": "show_policies", "label": "Show policy links", "default": true },
    { "type": "checkbox", "id": "show_payment", "label": "Show payment icons", "default": true }
  ],
  "blocks": [
    {
      "type": "menu",
      "name": "Menu",
      "limit": 3,
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading" },
        { "type": "link_list", "id": "menu", "label": "Menu", "default": "main-menu" }
      ]
    }
  ],
  "presets": [{ "name": "Usurper footer" }],
  "enabled_on": { "groups": ["footer"] }
}
{% endschema %}
